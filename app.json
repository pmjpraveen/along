{
  "expo": {
    "name": "along",
    "slug": "along",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "along",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "xyz.getalong.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#21231d",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "xyz.getalong.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#222222",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "ios": {
            "image": "./assets/images/splash-frame.png",
            "resizeMode": "cover",
            "enableFullScreenImage_legacy": true,
            "backgroundColor": "#222222"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "along listens only while you tap the mic, to turn what you say into text.",
          "speechRecognitionPermission": "along uses speech recognition to turn what you say into text."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c6946cac-267d-4148-a50c-55e82368c484"
      }
    },
    "owner": "pmjpraveen"
  }
}
